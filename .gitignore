# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments / package managers
.venv/
venv/
node_modules/

# Test + tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Dossier runtime state (created at launch under the selected root or repo root)
.dossier/

# Frontend build output
ui/dist/

# Verification run artifacts (large binaries / live caches produced by verification runs)
.verification/live-cache/
.verification/live-render/
.verification/*.png

# graphify machine-local + regenerable state.
# Commit-safe graph artifacts (graph.json, GRAPH_REPORT.md, scope.json,
# .graphify_labels.json, .graphify_detect.json) stay tracked.
# Never tracked: worktree/branch state, AST cache, instruction batches, and the
# manifest (absolute machine paths, not portable).
.graphify/branch.json
.graphify/worktree.json
.graphify/needs_update
.graphify/cache/
.graphify/manifest.json
.graphify/description-instructions/
.graphify/label-instructions/
.graphify/.graphify_describe_pending

# graphify-out — the canonical Python-graphify graph directory (supersedes .graphify).
# Same policy as the block above: commit-safe graph artifacts stay tracked, while
# machine-local and regenerable state does not. graph.html is rebuilt by the export
# step, manifest.json and the two dot-files carry absolute machine paths, and cache/
# holds the extraction cache — none of them is portable.
graphify-out/cache/
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/graph.html
graphify-out/.graphify_python
graphify-out/.graphify_root
# Dated pre-update backup the tool writes before it rebuilds the curated graph.
graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Environment / secrets
.env
.env.*
*.pem
*.key

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
