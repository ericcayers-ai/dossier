# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments / package managers
.venv/
venv/
node_modules/

# Test + tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Dossier runtime state (created at launch under the selected root or repo root)
.dossier/

# Frontend build output
ui/dist/

# Verification run artifacts (large binaries / live caches produced by verification runs)
.verification/live-cache/
.verification/live-render/
.verification/*.png

# graphify machine-local + regenerable state.
# Commit-safe graph artifacts (graph.json, GRAPH_REPORT.md, scope.json,
# .graphify_labels.json, .graphify_detect.json) stay tracked.
# Never tracked: worktree/branch state, AST cache, instruction batches, and the
# manifest (absolute machine paths, not portable).
.graphify/branch.json
.graphify/worktree.json
.graphify/needs_update
.graphify/cache/
.graphify/manifest.json
.graphify/description-instructions/
.graphify/label-instructions/
.graphify/.graphify_describe_pending

# graphify-out — the canonical Python-graphify graph directory (supersedes .graphify).
# Same policy as the block above: commit-safe graph artifacts stay tracked, while
# machine-local and regenerable state does not. graph.html is rebuilt by the export
# step, manifest.json and the two dot-files carry absolute machine paths, and cache/
# holds the extraction cache — none of them is portable.
graphify-out/cache/
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/graph.html
graphify-out/.graphify_python
graphify-out/.graphify_root
# Dated pre-update backup the tool writes before it rebuilds the curated graph.
graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# The legacy Node-graphify directory was retired to history (see tasks/WORKLIST.md). Its
# commit-safe artifacts are preserved there, while the machine-local caches and the
# absolute-path-bearing files stay out of git exactly as they were at the original path.
docs/history/graphify-legacy-2026-09-12/cache/
docs/history/graphify-legacy-2026-09-12/description-instructions/
docs/history/graphify-legacy-2026-09-12/label-instructions/
docs/history/graphify-legacy-2026-09-12/.graphify_describe_pending
docs/history/graphify-legacy-2026-09-12/manifest.json
docs/history/graphify-legacy-2026-09-12/branch.json
docs/history/graphify-legacy-2026-09-12/worktree.json

# Environment / secrets
.env
.env.*
*.pem
*.key

# Agent-tool state — per-machine tooling, NOT a deliverable (untracked 2026-10-11).
# The Dossier contract packs are a different thing: they are generated *product*
# output of `dossier agent adapters` (src/dossier/agent/adapters.py) and stay
# tracked — AGENTS.md, CLAUDE.md, GEMINI.md, .cursor/rules/dossier.mdc,
# .claude/skills/dossier/SKILL.md, docs/PIPELINE.md, docs/CONTRACT.md.
.claude/settings.json
.claude/helpers/
.claude/skills/graft/
.cursor/rules/graft.mdc

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# A labels sheet is generated from the owner's own folder and carries real employer and
# role names. The metric is reproducible from the folder; the names must never enter git.
docs/evidence/*-labels-*.json
